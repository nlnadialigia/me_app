generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id          String   @id @default(cuid())
  name        String
  title       String
  bio         String[]
  email       String
  avatarUrl   String?  @map("avatar_url")
  githubUrl   String?  @map("github_url")
  linkedinUrl String?  @map("linkedin_url")

  @@map("profile")
}

model Project {
  id           String   @id @default(cuid())
  name         String
  description  String
  liveUrl      String?  @map("live_url")
  githubUrl    String?  @map("github_url")
  imageUrl     String?  @map("image_url")
  technologies String[] @map("technologies")
  orderIndex   Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("projects")
}

// Models required by NextAuth (and a `password` field on User for credentials)
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String? // hashed password for CredentialsProvider
  accounts      Account[]
  sessions      Session[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id])

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id])

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@map("verification_tokens")
}
